{
  "extraKnownMarketplaces": {
    "the-foundry": {
      "source": {
        "source": "github",
        "repo": "attac-t/the-foundry"
      }
    }
  },
  "enabledPlugins": {
    "kernel@the-foundry": true,
    "signal@the-foundry": true,
    "floor@the-foundry": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/seam.sh\""
          }
        ]
      }
    ]
  }
}
