# Session-specific working memory (developers create their own)
.claude/memory/

# Local settings overrides (use .claude/settings.local.json for local-only config)
.claude/settings.local.json

# Self-development symlink (created during plugin development)
.claude/plugins/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
