# Session-specific working memory (developers create their own)
.claude/memory/

# Review artifacts: charters and verdicts stay local to the branch that produced them
.claude/panel/

# Personal overrides. `.claude/settings.json` is the project's and is committed — it names the
# marketplace by repository rather than by a path on one machine, so it holds nothing local.
.claude/settings.local.json

# Self-development symlink (created during plugin development)
.claude/plugins/

# A failing gate's output belongs under floor's home, and this line is for the one case that has
# none: `bin/gates.sh` keeps it beside the checkout when neither `FOUNDRY_HOME` nor `HOME` is set.
# Losing the output is worse than an ignored directory.
.foundry-runs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Reference materials (PDFs, extracted books)
references/
laravel-beyond-crud/
laravel-event-sourcing/
