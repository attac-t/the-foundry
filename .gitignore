# Session-specific working memory (developers create their own)
.claude/memory/

# Review artifacts: charters and verdicts stay local to the branch that produced them
.claude/panel/

# Design prose: RFCs are how a decision got made, not what shipped. The decision reaches the repo as
# code, a commit message, or an issue — never as a document nobody updates.
docs/rfc/

# Local settings (may contain local paths)
.claude/settings.json
.claude/settings.local.json

# Self-development symlink (created during plugin development)
.claude/plugins/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Reference materials (PDFs, extracted books)
references/
laravel-beyond-crud/
laravel-event-sourcing/
